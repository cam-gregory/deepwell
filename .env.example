# Copy to .env and fill in. The app reads these at startup.

# Shared password for the whole app (HTTP Basic, any username).
# Leave unset/empty to run fully open (local dev). Set a strong value when
# exposing a test deployment to the internet.
DEEPWELL_PASSWORD=change-me

# --- Optional hybrid cloud ingestion LLM ---
# The app always ANSWERS offline with the local model. These only affect the
# one-time ingestion metadata/OCR steps, and fall back to local automatically on
# any error or when offline. Leave DEEPWELL_INGEST_LLM=local (or unset) to keep
# ingestion fully offline too. Do NOT send restricted/internal content to a
# third-party API without checking your data policy first.
#
# IMPORTANT: put your real key in .env (gitignored), NOT here. This file is
# committed — keep it placeholder-only.
DEEPWELL_INGEST_LLM=local
DEEPWELL_CLOUD_API_KEY=
DEEPWELL_CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEEPWELL_CLOUD_MODEL=gemini-3.1-flash-lite
# Optional: "none" disables thinking on models that support it so they return
# actual content (needed for OCR on some Gemini models). Empty = provider default.
DEEPWELL_CLOUD_REASONING=none
# Optional hard cap on output tokens (0/unset = provider default).
DEEPWELL_CLOUD_MAX_TOKENS=8192