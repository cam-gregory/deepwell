[Unit]
Description=Deepwell FastAPI app
# Start after Ollama so the LLM backend is reachable at localhost:11434.
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
# Adjust User and paths to match where you cloned the repo.
User=ubuntu
WorkingDirectory=/home/ubuntu/deepwell
EnvironmentFile=/home/ubuntu/deepwell/.env
ExecStart=/home/ubuntu/deepwell/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
